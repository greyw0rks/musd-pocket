# --- Database (Neon Postgres) ---
# Paste your Neon pooled connection string here.
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=""
# Direct (non-pooled) connection, used for prisma db push / migrations
DIRECT_URL=""

# --- Mezo network ---
# "testnet" (chain 31611, default) or "mainnet" (chain 31612)
NEXT_PUBLIC_MEZO_ENV="testnet"
# Optional: override the default public RPC with your own endpoint
NEXT_PUBLIC_MEZO_RPC_URL=""

# --- Wallet (optional) ---
# Set a WalletConnect / Reown Cloud projectId to enable mobile wallet QR pairing.
# Leave empty to use injected (browser extension) wallets only.
NEXT_PUBLIC_WC_PROJECT_ID=""

# Public base URL used for shareable request links (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Privy (embedded wallet + social auth) ---
# Create an app at dashboard.privy.io, enable X/Twitter + Telegram login, and
# register Mezo testnet (31611) as a supported chain.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# --- Relayer (gasless) ---
# Hot wallet that pays BTC gas on users' behalf. Fund with Mezo testnet BTC.
# 0x-prefixed private key — keep secret, server-only.
RELAYER_PRIVATE_KEY=""
