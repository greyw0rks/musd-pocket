# Database: Neon Postgres. Review additive SQL in prisma/sql; avoid live db push.
DATABASE_URL=""
DIRECT_URL=""

# Mezo: testnet (31611, default) or mainnet (31612).
# New Swap/Wealth actions are testnet-only.
NEXT_PUBLIC_MEZO_ENV="testnet"
NEXT_PUBLIC_MEZO_RPC_URL=""

# Privy: register local/deployed origins and Mezo testnet.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional legacy wallet pairing.
NEXT_PUBLIC_WC_PROJECT_ID=""

# Server-only relayer: testnet faucet and welcome claim gas.
# Ordinary direct payments/Wealth use the user's BTC for gas.
RELAYER_PRIVATE_KEY=""
# Configure only after deployment, verification and funding.
POCKET_WELCOME_REWARD_ADDRESS=""
POCKET_WELCOME_REWARD_CHAIN_ID="31611"

# Legacy vault/indexing; direct payments and checkout do not use the vault.
NEXT_PUBLIC_POCKET_VAULT_ADDRESS=""
POCKET_VAULT_DEPLOY_BLOCK=""

# Reconciliation: direct receipt recovery + explicit legacy-vault rows.
CRON_SECRET=""
RECONCILE_GRACE_MS=""
RECONCILE_BATCH=""

# Legacy app gate; /home uses Privy authentication.
POCKET_ACCESS_TOKEN=""

# Abandoned per-user deposit-box design; unused.
NEXT_PUBLIC_POCKET_DEPOSITS_ADDRESS=""
POCKET_DEPOSITS_DEPLOY_BLOCK=""
