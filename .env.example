# --- Database (Neon Postgres) ---
# Paste your Neon pooled connection string here.
# Example: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=""
# Direct (non-pooled) connection, used for prisma db push / migrations
DIRECT_URL=""

# --- Mezo network ---
# "testnet" (chain 31611, default) or "mainnet" (chain 31612)
NEXT_PUBLIC_MEZO_ENV="testnet"
# Optional: override the default public RPC with your own endpoint
NEXT_PUBLIC_MEZO_RPC_URL=""

# --- Wallet (optional) ---
# Set a WalletConnect / Reown Cloud projectId to enable mobile wallet QR pairing.
# Leave empty to use injected (browser extension) wallets only.
NEXT_PUBLIC_WC_PROJECT_ID=""

# Public base URL used for shareable request links (no trailing slash)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Privy (embedded wallet + social auth) ---
# Create an app at dashboard.privy.io, enable X/Twitter + Telegram login, and
# register Mezo testnet (31611) as a supported chain.
NEXT_PUBLIC_PRIVY_APP_ID=""
PRIVY_APP_SECRET=""

# --- Relayer (faucet and welcome claims) ---
# Fund with testnet BTC, mUSD and MEZO for the configured claim budgets.
# Ordinary direct payments, Troves and Savings use the user's wallet and BTC.
# 0x-prefixed private key — keep secret, server-only.
RELAYER_PRIVATE_KEY=""

# --- Welcome reward (Mezo testnet only) ---
# PocketWelcomeReward campaign, NOT the veMEZO escrow address. Leave blank
# until the campaign is deployed, verified and funded with testnet MEZO.
# Each claim creates a recipient-owned 200 MEZO lock for two weekly epochs.
POCKET_WELCOME_REWARD_ADDRESS=""
POCKET_WELCOME_REWARD_CHAIN_ID="31611"
POCKET_ENABLE_LEGACY_SETTLEMENT="false"

# --- Historical PocketVault (optional legacy recovery only) ---
# Current direct transfers and receipt recovery do not require a PocketVault.
# Vault mutations stay disabled unless POCKET_ENABLE_LEGACY_SETTLEMENT=true.
NEXT_PUBLIC_POCKET_VAULT_ADDRESS=""
# Block the vault was deployed at. The deposit indexer and the reconciler's
# log scan both start here; leaving it blank makes them fall back to a short
# rolling window, which silently misses older history.
POCKET_VAULT_DEPLOY_BLOCK=""

# --- Reconciliation (cron) ---
# Shared secret for GET /api/cron/reconcile. The route is reachable from the
# internet and returns 401 when this is unset. Direct receipt recovery never
# signs wallet transactions. Legacy ledger recovery requires the opt-in flag.
# Vercel Cron sends it as: Authorization: Bearer $CRON_SECRET
CRON_SECRET=""
# How long an attempt stays protected from being read as "never happened"
# (ms). Below this age a silent attempt is held, not refunded, because it
# could still be sitting in the mempool. Default 900000 (15 min).
RECONCILE_GRACE_MS=""
# Max unresolved rows examined per run. Default 25, capped at 200.
RECONCILE_BATCH=""

# --- App access gate ---
# When set, the /app surface requires this token. Server-only.
POCKET_ACCESS_TOKEN=""

# --- Legacy: PocketDeposits (UNUSED) ---
# From an abandoned per-user deposit-box design. No source file references these
# and the contract is deployed but unused by current payments. Kept only to
# document existing deployment references; do not wire new work to them.
NEXT_PUBLIC_POCKET_DEPOSITS_ADDRESS=""
POCKET_DEPOSITS_DEPLOY_BLOCK=""
