// MUSD Pocket — chain-abstracted payment ledger.
//
// The DB is an INDEXED REPRESENTATION of on-chain state, not the source of truth.
// On-chain (real, Mezo testnet): vault balances, deposits, withdrawals, payouts.
// Off-chain (here): users, ledger balances, routing/settlement accounting, history.
// Addresses stored LOWERCASE for lookups; the UI re-checksums for display.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Supported chains. Only MEZO is real on testnet; BASE/ETHEREUM are modeled.
enum ChainKey {
  MEZO
  BASE
  ETHEREUM
}

/// Which token a row moved.
///
/// Rows are filed per asset and are never summed across: `amount` is denominated
/// in the row's own token, so a total that added a BTC row to a MUSD one would
/// be a figure with no meaning. The column exists so a reader can tell which
/// token it is holding without knowing where the row came from.
enum AssetKey {
  MUSD
  BTC
}

enum TxType {
  DEPOSIT
  SEND
  RECEIVE
  WITHDRAW
  SETTLEMENT
}

enum TxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  SETTLED
}

enum PaymentStatus {
  PENDING // created, not yet paid out
  UNCLAIMED // held by Pocket for someone who has no account yet
  PAID // instant payout delivered on destination chain
  SETTLED // obligation netted + settled across vaults
  FAILED // payout failed on-chain; funds returned to the sender
}

enum ObligationStatus {
  OPEN
  NETTED
  SETTLED
}

/// Kept so the schema still describes the live database, which carries this
/// column on every user row (all currently PERSONAL). A retired design — see
/// the note on Payment.claimHandle. Do not build on it.
enum AccountRole {
  PERSONAL
  MERCHANT
}

// <!-- APPEND-MARKER -->

/// A marketing-site waitlist signup. Deliberately NOT a User — these are
/// anonymous emails captured before launch, with no wallet or identity.
model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique // normalised to lowercase before storage
  source    String? // which surface captured it, e.g. "landing"
  createdAt DateTime @default(now())

  @@map("waitlist")
}

/// A Pocket user. Identity = X/Telegram; the embedded Privy wallet is one EVM
/// address usable on every chain. Balance split into available vs frozen (held
/// against an in-flight payment until it settles).
model User {
  id               String   @id @default(cuid())
  username         String   @unique
  xId              String?  @unique
  xHandle          String?
  telegramId       String?  @unique
  telegramHandle   String?
  walletAddress    String   @unique // lowercase embedded-wallet EOA
  /// The X profile picture, copied from Privy at every login. Hot-linked and
  /// therefore allowed to rot: the UI falls back to initials, so this is a
  /// convenience and never something a screen depends on. Null for accounts
  /// that signed in with Telegram or email, or whose X profile has no picture.
  avatarUrl        String?  @db.Text
  preferredChain   ChainKey    @default(MEZO)
  role             AccountRole @default(PERSONAL)
  availableBalance Decimal     @default(0) @db.Decimal(38, 18)
  frozenBalance    Decimal     @default(0) @db.Decimal(38, 18)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  transactions     Transaction[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]
  sentPayments     Payment[]     @relation("PaymentSender")
  receivedPayments Payment[]     @relation("PaymentRecipient")
  faucetClaim      FaucetClaim?

  @@index([walletAddress])
  @@map("users")
}

/// Flat activity feed row (what the Activity screen renders).
model Transaction {
  id           String    @id @default(cuid())
  type         TxType
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  counterparty String? // @username or address, display-only
  amount       Decimal   @db.Decimal(38, 18)
  token        String // mUSD contract (lowercase)
  sourceChain  ChainKey?
  destChain    ChainKey?
  status       TxStatus  @default(PENDING)
  paymentId    String? // links SEND/RECEIVE to a Payment
  txHash       String?
  note         String?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([status])
  @@map("transactions")
}

/// Inbound funding: MUSD lands in a vault, ledger credits the user.
model Deposit {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  chain        ChainKey
  amount       Decimal  @db.Decimal(38, 18)
  txHash       String   @unique // the on-chain Transfer into the vault
  vaultAddress String
  status       TxStatus @default(PROCESSING)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@map("deposits")
}

/// Outbound: money leaves a wallet to an external address on the chosen chain.
///
/// Two different outbounds share this table, and `asset` is what tells them
/// apart:
///
///  - **MUSD** — the older one, and still the only one the settlement engine
///    runs: the vault releases MUSD and the relayer pays the gas. It is debited
///    against the Pocket ledger up front and carries a `paymentId` so the
///    reconciler can ask the vault's `processed` mapping whether the release
///    happened.
///  - **BTC** — the user's own wallet signing a native transfer. There is no
///    vault call, so no `paymentId`; and no ledger debit, because the money was
///    never in the Pocket ledger. **The reconciler must never see one** — it
///    reverses what it cannot account for, which for a BTC row would credit a
///    user for money that really did leave. See the `asset` filter in
///    `lib/settlement/reconcile.ts`, which is what keeps that from happening.
model Withdrawal {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  chain     ChainKey
  /// Which token left. Defaults to MUSD because every row filed before this
  /// column existed was a vault release of MUSD — the only outbound the app
  /// had. A nullable column would have to be guessed at read time, and a wrong
  /// guess here is the difference between a dollar figure and a bitcoin one.
  asset     AssetKey @default(MUSD)
  toAddress String // lowercase
  /// Amount in the row's own token, at display precision: MUSD to 2 decimals,
  /// BTC to 8. The activity reader parses it back with the parser that matches
  /// `asset`, so a value stored at the wrong scale reads back as zero.
  amount    Decimal  @db.Decimal(38, 18)
  status    TxStatus @default(PENDING)
  txHash    String?
  /// The bytes32 tag the on-chain `withdraw` was called with. Needed to ask the
  /// vault's `processed` mapping whether the release happened — without it a
  /// withdrawal whose outcome is unknown cannot be reconciled safely.
  ///
  /// A BTC row carries its own transaction hash here instead, for the same
  /// reason `Payment` does: it is already a bytes32, already unique, and already
  /// known to both sides — which is what makes a retry the same row rather than
  /// a second one. Nothing tags a BTC row with a vault handle, so the field has
  /// nothing else to hold.
  paymentId String?  @unique
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("withdrawals")
}

/// A Pocket-to-Pocket (or Pocket-to-address) send. `paymentId` is the bytes32
/// handle the on-chain vault payout is tagged with (idempotency key).
model Payment {
  id               String        @id @default(cuid())
  paymentId        String        @unique // bytes32 hex
  senderId         String
  sender           User          @relation("PaymentSender", fields: [senderId], references: [id])
  recipientId      String?
  recipient        User?         @relation("PaymentRecipient", fields: [recipientId], references: [id])
  recipientAddress String? // lowercase, for non-Pocket recipients
  /// Retired "hold and claim" design: the recipient had no account yet, so the
  /// send was reserved against a name and released when someone registered it.
  /// One live row still carries this — a PAID payment reserved for "musd_pocket".
  /// Kept only so the schema describes the live database. Nothing reads it.
  claimHandle      String? // reserved for a name that has no account yet
  amount           Decimal       @db.Decimal(38, 18)
  note             String?
  destChain        ChainKey
  status           PaymentStatus @default(PENDING)
  payoutTxHash     String? // real tx when destChain == MEZO
  createdAt        DateTime      @default(now())
  paidAt           DateTime?
  settledAt        DateTime?
  claimedAt        DateTime? // when a reserved payment found its owner

  @@index([senderId])
  @@index([recipientId])
  @@index([status])
  @@index([claimHandle, status])
  @@map("payments")
}

/// Point-in-time vault liquidity per chain — feeds the protocol dashboard.
model VaultSnapshot {
  id          String   @id @default(cuid())
  chain       ChainKey
  balance     Decimal  @db.Decimal(38, 18)
  blockNumber BigInt?
  capturedAt  DateTime @default(now())

  @@index([chain])
  @@map("vault_snapshots")
}

/// A cross-chain IOU created when a payout happens on a chain other than where
/// the source liquidity sits. Netted + settled in batches.
model SettlementObligation {
  id        String           @id @default(cuid())
  fromChain ChainKey
  toChain   ChainKey
  amount    Decimal          @db.Decimal(38, 18)
  status    ObligationStatus @default(OPEN)
  window    String? // settlement window id once netted
  paymentId String?
  createdAt DateTime         @default(now())

  @@index([status])
  @@map("settlement_obligations")
}

/// A settlement batch: the net movements executed (simulated NTT) in a window.
model Settlement {
  id           String    @id @default(cuid())
  window       String    @unique
  netMovements Json // [{ fromChain, toChain, amount }]
  status       TxStatus  @default(PENDING)
  executedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@map("settlements")
}

model Contact {
  id             String   @id @default(cuid())
  ownerAddress   String // lowercase
  contactAddress String // lowercase
  label          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([ownerAddress, contactAddress])
  @@index([ownerAddress])
  @@map("contacts")
}

/// Retained for P1 (QR / shareable payment links). Status flow unchanged.
model PaymentRequest {
  id               String        @id @default(cuid())
  shortId          String        @unique
  creatorAddress   String
  recipientAddress String
  amount           Decimal       @db.Decimal(38, 18)
  token            String
  chainId          Int
  description      String?
  status           RequestStatus @default(PENDING)
  txHash           String?
  payerAddress     String?
  expiresAt        DateTime?
  createdAt        DateTime      @default(now())
  paidAt           DateTime?

  @@index([creatorAddress])
  @@index([status])
  @@map("payment_requests")
}

enum RequestStatus {
  PENDING
  PROCESSING
  PAID
  EXPIRED
}

/// One testnet faucet claim per user.
///
/// The row is opened before the first transfer and each transaction hash is
/// written the moment it exists, so a claim interrupted between the two legs
/// resumes on retry without paying the finished leg twice. `claimingAt` is a
/// short lease won by a conditional update: two concurrent requests cannot
/// both send. A finished claim keeps its hashes as the receipt.
model FaucetClaim {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id])
  walletAddress String // lowercase — the wallet the faucet paid
  btcTxHash     String?
  musdTxHash    String?
  error         String?
  claimingAt    DateTime?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("faucet_claims")
}
